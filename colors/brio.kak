# For Code
face global value     rgb:d3005b,default,default
face global type      rgb:006d4c,default,default
face global variable  rgb:ffffff,default,default
face global module    rgb:4c54e8,default,default
face global function  rgb:4c54e8,default,default
face global string    rgb:ff1ea1,default,default
face global keyword   rgb:e69100,default,default
face global operator  rgb:ffffff,default,default
face global attribute rgb:ef2745,default,default
face global comment   rgb:ffffff,default,default
face global meta      rgb:1f1fd2,default,default
face global builtin   rgb:4c54e8,default,default
face global parameter rgb:ffffff,default,default+b

# For markup
face global title  rgb:2a2a32,default,default
face global header rgb:d3005b,default,default
face global bold   default,default,default+b
face global italic default,default,default+i
face global mono   rgb:006d4c,default,default
face global block  rgb:006d4c,default,default
face global link   rgb:2a2a32,default,default
face global bullet rgb:e69100,default,default
face global list   rgb:1e1e26,default,default

# Builtin faces
face global Default            rgb:ffffff,default,default
face global PrimarySelection   rgba:99999977,rgb:ffffff,default
face global SecondarySelection rgba:aaaaaa77,rgb:d5d5de,default
face global PrimaryCursor      rgb:d5d5de,rgb:ffffff,default
face global SecondaryCursor    rgb:d5d5de,rgb:ffffff,default
face global PrimaryCursorEol   rgb:d5d5de,rgb:ffffff,default
face global SecondaryCursorEol rgb:d5d5de,rgb:ffffff,default
face global LineNumbers        rgb:ffffff,default,default
face global LineNumbersWrapped rgb:d5d5de,default,default
face global LineNumberCursor   rgb:e69100,default,default
face global WrapMarker         rgb:ffffff,default,default
face global MenuForeground     rgb:000000,rgb:d5d5de,default+r
face global MenuBackground     rgb:000000,rgb:d5d5de,default
face global MenuInfo           rgb:006d4c,default,default
face global Information        rgb:000000,rgb:d5d5de,default
face global Error              rgb:ef2745,default,default+b
face global StatusLine         rgb:000000,rgb:d5d5de,default
face global StatusLineMode     rgb:006d4c,default,default
face global StatusLineInfo     rgb:2a2a32,default,default
face global StatusLineValue    green,default
face global StatusCursor       rgb:d5d5de,rgb:ffffff,default
face global Prompt             rgb:e69100,default,default
face global MatchingChar       rgb:ef2745,default,default
face global BufferPadding      rgb:111111+F

# kakoune-lsp
face global DiagnosticError           default,default,rgb:ef2745+u
face global DiagnosticWarning         default,default,rgb:ffffff+u
face global Reference                 default,default,rgb:ffffff+u
face global InfoDefault               Information
face global InfoBlock                 block
face global InfoBlockQuote            string
face global InfoBullet                bullet
face global InfoHeader                header
face global InfoLink                  link
face global InfoLinkMono              mono
face global InfoMono                  mono
face global InfoRule                  Information
face global InfoDiagnosticError       Error
face global InfoDiagnosticHint        default,default,default+i
face global InfoDiagnosticInformation Information
face global InfoDiagnosticWarning     rgb:e69100,default,default
face global PhantomSelection          default,default,rgb:ffffff+u
